@page "/realms"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Guncho.Client.Services
@using Guncho.Shared.Models
@inject RealmsService RealmsService
@inject PlayerService PlayerService
@inject NavigationManager Navigation

<PageTitle>Realms - Guncho</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 class="mb-0">Realms</h2>
            <div class="text-muted">Create, manage, and explore shared worlds.</div>
        </div>
        <button class="btn btn-primary" @onclick="ToggleCreateRealm" disabled="@isLoading">
            <span class="bi bi-plus-circle me-1"></span>
            New Realm
        </button>
    </div>

    <div class="mt-4">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <button class="nav-link @(selectedTab == RealmTab.All ? "active" : null)" @onclick="() => SelectTab(RealmTab.All)">
                    All Realms
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(selectedTab == RealmTab.Mine ? "active" : null)" @onclick="() => SelectTab(RealmTab.Mine)" disabled="@(currentPlayer is null)">
                    My Realms
                </button>
            </li>
        </ul>
    </div>

    <div class="mt-3 row g-2 align-items-center">
        <div class="col-md-6 col-lg-5">
            <div class="input-group">
                <span class="input-group-text"><span class="bi bi-search"></span></span>
                <input type="text" class="form-control" placeholder="Search realms" @bind="search" @bind:event="oninput" />
            </div>
        </div>
    </div>

    @if (showCreateRealm)
    {
        <div class="card mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Create a New Realm</strong>
                <button type="button" class="btn-close" @onclick="ToggleCreateRealm"></button>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(createMessage))
                {
                    <div class="alert @(createSuccessful ? "alert-success" : "alert-danger")">@createMessage</div>
                }

                <EditForm Model="newRealm" OnValidSubmit="CreateRealmAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Realm Name</label>
                            <InputText class="form-control" @bind-Value="newRealm.Name" placeholder="My Amazing Realm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Factory</label>
                            <InputSelect class="form-select" @bind-Value="newRealm.FactoryName">
                                @foreach (var factory in factories)
                                {
                                    <option value="@factory.Name">@factory.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Privacy</label>
                            <InputSelect class="form-select" @bind-Value="newRealm.PrivacyLevel">
                                @foreach (RealmPrivacyLevel level in Enum.GetValues(typeof(RealmPrivacyLevel)))
                                {
                                    <option value="@level">@level</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-success" disabled="@isCreating">
                            @if (isCreating)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Create Realm
                        </button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ToggleCreateRealm">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!filteredRealms.Any())
    {
        <div class="alert alert-info mt-4">
            <div class="d-flex align-items-center gap-2">
                <span class="bi bi-info-circle"></span>
                <span>No realms found. Try adjusting your filters or create a new realm.</span>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-lg-2 g-4 mt-1">
            @foreach (var realm in filteredRealms)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title mb-1">@realm.Name</h5>
                                    <div class="text-muted small">Owned by @realm.OwnerName</div>
                                </div>
                                <span class="badge bg-secondary">@realm.PrivacyLevel</span>
                            </div>
                            <div class="mt-3 small">
                                <div><span class="bi bi-gear me-2"></span>Factory: @realm.FactoryName</div>
                            </div>
                        </div>
                        <div class="card-footer d-flex flex-wrap gap-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => NavigateToDetails(realm.Name)">
                                <span class="bi bi-info-circle me-1"></span>Details
                            </button>
                            <button class="btn btn-sm btn-primary" @onclick="() => NavigateToPlay(realm.Name)">
                                <span class="bi bi-play-fill me-1"></span>Play
                            </button>

                            @if (CanManageRealm(realm))
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => NavigateToEdit(realm.Name)">
                                    <span class="bi bi-pencil-square me-1"></span>Edit
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(realm)">
                                    <span class="bi bi-trash me-1"></span>Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (realmPendingDeletion != null)
    {
        <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Realm</h5>
                        <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete <strong>@realmPendingDeletion.Name</strong>? This cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">
                            @if (isDeleting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
</div>

@code {
    private enum RealmTab { All, Mine }

    private RealmTab selectedTab = RealmTab.All;
    private List<RealmSummaryDto> allRealms = new();
    private List<RealmFactoryDto> factories = new();
    private PlayerDto? currentPlayer;
    private IEnumerable<RealmSummaryDto> filteredRealms => FilterRealms();

    private CreateRealmDto newRealm = new() { PrivacyLevel = RealmPrivacyLevel.Public };
    private string? createMessage;
    private bool createSuccessful;

    private bool isLoading = true;
    private bool isCreating;
    private bool showCreateRealm;
    private string search = string.Empty;

    private RealmSummaryDto? realmPendingDeletion;
    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        currentPlayer = await PlayerService.GetCurrentPlayerAsync();
    allRealms = (await RealmsService.GetAllRealmsAsync()).ToList();
    factories = (await RealmsService.GetRealmFactoriesAsync()).ToList();

        if (string.IsNullOrEmpty(newRealm.FactoryName) && factories.Any())
        {
            newRealm.FactoryName = factories.First().Name;
        }

        isLoading = false;
    }

    private IEnumerable<RealmSummaryDto> FilterRealms()
    {
        var query = allRealms.AsEnumerable();

        if (selectedTab == RealmTab.Mine && currentPlayer != null)
        {
            query = query.Where(r => string.Equals(r.OwnerName, currentPlayer.Name, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(search))
        {
            query = query.Where(r => r.Name.Contains(search, StringComparison.OrdinalIgnoreCase) || r.OwnerName.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        return query.OrderBy(r => r.Name);
    }

    private void SelectTab(RealmTab tab)
    {
        selectedTab = tab;
    }

    private void ToggleCreateRealm()
    {
        showCreateRealm = !showCreateRealm;
        createMessage = null;
        createSuccessful = false;

        if (showCreateRealm)
        {
            newRealm = new CreateRealmDto
            {
                PrivacyLevel = RealmPrivacyLevel.Public,
                FactoryName = factories.FirstOrDefault()?.Name ?? "Inform7"
            };
        }
    }

    private async Task CreateRealmAsync()
    {
        isCreating = true;
        var result = await RealmsService.CreateRealmAsync(newRealm);
        isCreating = false;

        createSuccessful = result.IsSuccess;
        createMessage = result.IsSuccess
            ? $"Realm '{result.Value?.Name ?? newRealm.Name}' created successfully."
            : result.Error ?? "Failed to create realm.";

        if (result.IsSuccess)
        {
            showCreateRealm = false;
            await LoadAsync();
        }
    }

    private bool CanManageRealm(RealmSummaryDto realm)
    {
        if (currentPlayer == null)
        {
            return false;
        }

        return currentPlayer.IsAdmin || string.Equals(realm.OwnerName, currentPlayer.Name, StringComparison.OrdinalIgnoreCase);
    }

    private void NavigateToPlay(string realmName)
    {
        Navigation.NavigateTo($"/play?realm={Uri.EscapeDataString(realmName)}");
    }

    private void NavigateToDetails(string realmName)
    {
        Navigation.NavigateTo($"/realms/{Uri.EscapeDataString(realmName)}");
    }

    private void NavigateToEdit(string realmName)
    {
        Navigation.NavigateTo($"/realms/{Uri.EscapeDataString(realmName)}/edit");
    }

    private void RequestDelete(RealmSummaryDto realm)
    {
        realmPendingDeletion = realm;
    }

    private void CancelDelete()
    {
        realmPendingDeletion = null;
        isDeleting = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (realmPendingDeletion == null)
        {
            return;
        }

        isDeleting = true;
        var success = await RealmsService.DeleteRealmAsync(realmPendingDeletion.Name);
        isDeleting = false;

        if (success)
        {
            allRealms = allRealms.Where(r => !string.Equals(r.Name, realmPendingDeletion.Name, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        CancelDelete();
    }
}
