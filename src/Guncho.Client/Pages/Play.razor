@page "/play"
@using System.Linq
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Guncho.Client.Services
@using Blazored.LocalStorage
@using Guncho.Client.Shared
@implements IDisposable
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject PlayConnectionService PlayConnection
@inject ILocalStorageService LocalStorage

<PageTitle>Play - Guncho</PageTitle>

<div class="container py-4">
    <div class="row mb-3">
        <div class="col-lg-8">
            <h2 class="mb-0">Play Now</h2>
            <div class="text-muted">Connect to a realm to explore multiplayer interactive fiction.</div>
        </div>
        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Transcript</strong>
                    <div class="text-muted small">
                        <span class="bi bi-lightning-charge me-1 @(ConnectionSlow ? "text-warning" : string.Empty)"></span>
                        @(ConnectionSlow ? "Connection is slow" : "Live")
                    </div>
                </div>
                <div class="card-body p-0">
                    <GlkGameport OnLineEntered="SendCommandFromGlk" @ref="glkPort" />
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong>Session</strong>
                        <span>
                            @ConnectionState
                            <span class="bi @(ConnectionState switch
                                            {
                                                PlayConnectionState.Connected => "bi-plug-fill",
                                                PlayConnectionState.Connecting => "bi-broadcast",
                                                PlayConnectionState.Reconnecting => "bi-arrow-repeat",
                                                _ => "bi-exclamation-octagon"
                                            }) ms-1"></span>
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (ConnectionState == PlayConnectionState.Disconnected)
                        {
                            <button class="btn btn-success" @onclick="ConnectAsync" disabled="@isConnecting">
                                @if (isConnecting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Connect
                            </button>
                        }
                        @if (ConnectionState == PlayConnectionState.Connected)
                        {
                            <button class="btn btn-outline-secondary" @onclick="DisconnectAsync">Disconnect</button>
                        }
                    </div>
                    @if (ConnectionState == PlayConnectionState.Connected && PlayConnection.CurrentRealm is { } realm)
                    {
                        <div class="mt-3 text-muted small">
                            <span class="bi bi-geo-fill me-1"></span>Connected to <strong>@realm</strong>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <strong>Recent Commands</strong>
                </div>
                <div class="card-body">
                    @if (!recentCommands.Any())
                    {
                        <div class="text-muted">Commands you send will appear here for quick reuse.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var entry in recentCommands)
                            {
                                <button type="button" class="list-group-item list-group-item-action" @onclick="() => ReuseCommand(entry)">@entry</button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "realm")]
    public string? RealmFromQuery { get; set; }

    private readonly List<string> recentCommands = new();
    private bool isConnecting;
    // Default starting realm assumed; preserved variable for service call
    private string selectedRealm = "The Outer Realm";
    private bool autoConnectRequested;
    private GlkGameport? glkPort;

    private PlayConnectionState ConnectionState => PlayConnection.ConnectionState;
    private bool ConnectionSlow => PlayConnection.ConnectionSlow;
    private bool CanDisconnect => ConnectionState != PlayConnectionState.Disconnected;

    protected override async Task OnInitializedAsync()
    {
        PlayConnection.StateChanged += HandleConnectionStateChanged;
        PlayConnection.LineReceived += HandleLineReceived;
        PlayConnection.GoodbyeReceived += HandleGoodbye;

        if (!string.IsNullOrWhiteSpace(PlayConnection.CurrentRealm))
        {
            selectedRealm = PlayConnection.CurrentRealm!;
        }

        // Restore persistent state from local storage
        await RestoreStateAsync();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(RealmFromQuery))
        {
            var realm = SanitizeRealmFromQuery(RealmFromQuery);
            if (!string.Equals(selectedRealm, realm, StringComparison.Ordinal))
            {
                selectedRealm = realm ?? string.Empty;
                autoConnectRequested = true;
            }
        }
        else
        {
            autoConnectRequested = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (autoConnectRequested && ConnectionState == PlayConnectionState.Disconnected && !isConnecting)
        {
            autoConnectRequested = false;
            await ConnectAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConnectAsync()
    {
        isConnecting = true;
        StateHasChanged();

        try
        {
            var realm = selectedRealm.Trim();
            await PlayConnection.ConnectToRealmAsync(realm);
            if (glkPort != null)
            {
                await glkPort.AppendServerLineAsync("[system] Connecting...");
            }
        }
        catch (Exception ex)
        {
            if (glkPort != null)
            {
                await glkPort.AppendServerLineAsync($"[system] Failed to connect: {ex.Message}");
            }
        }
        finally
        {
            isConnecting = false;
            StateHasChanged();
        }
    }

    private async Task DisconnectAsync()
    {
        await PlayConnection.DisconnectAsync();
        isConnecting = false;
        if (glkPort != null)
        {
            await glkPort.AppendServerLineAsync("[system] Disconnected.");
        }
        await SaveStateAsync();
        StateHasChanged();
    }

    private async Task SendCommandFromGlk(string command)
    {
        if (string.IsNullOrWhiteSpace(command))
        {
            return;
        }
        if (ConnectionState != PlayConnectionState.Connected)
        {
            if (glkPort != null)
            {
                await glkPort.AppendServerLineAsync("[system] You are not connected.");
            }
            return;
        }
        TrackRecentCommand(command);
        try
        {
            await PlayConnection.SendCommandAsync(command);
        }
        catch (Exception ex)
        {
            if (glkPort != null)
            {
                await glkPort.AppendServerLineAsync($"[system] Failed to send command: {ex.Message}");
            }
        }
    }

    private void TrackRecentCommand(string command)
    {
        recentCommands.Remove(command);
        recentCommands.Insert(0, command);

        if (recentCommands.Count > 10)
        {
            recentCommands.RemoveAt(recentCommands.Count - 1);
        }

        _ = SaveStateAsync(); // Fire and forget
    }

    private void ReuseCommand(string command)
    {
        _ = SendCommandFromGlk(command);
    }

    private void HandleLineReceived(string line)
    {
        _ = InvokeAsync(async () =>
        {
            if (glkPort != null)
            {
                await glkPort.AppendServerLineAsync(line);
            }
            StateHasChanged();
        });
    }

    private void HandleGoodbye()
    {
        _ = InvokeAsync(async () =>
        {
            if (glkPort != null)
            {
                await glkPort.AppendServerLineAsync("[system] Session closed by server.");
            }
            isConnecting = false;
            await PlayConnection.DisconnectAsync();
            await SaveStateAsync();
            StateHasChanged();
        });
    }

    private void HandleConnectionStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string? SanitizeRealmFromQuery(string? realm)
    {
        if (realm is null)
        {
            return null;
        }

        try
        {
            return Uri.UnescapeDataString(realm);
        }
        catch
        {
            return realm;
        }
    }

    private async Task RestoreStateAsync()
    {
        try
        {
            var savedCommands = await LocalStorage.GetItemAsync<List<string>>("play_recentCommands");
            if (savedCommands != null && savedCommands.Count > 0)
            {
                recentCommands.Clear();
                recentCommands.AddRange(savedCommands);
            }
        }
        catch (Exception ex)
        {
            // Log but don't fail if local storage isn't available
            Console.WriteLine($"Failed to restore play state: {ex.Message}");
        }
    }

    private async Task SaveStateAsync()
    {
        try
        {
            await LocalStorage.SetItemAsync("play_recentCommands", recentCommands);
        }
        catch (Exception ex)
        {
            // Log but don't fail if local storage isn't available
            Console.WriteLine($"Failed to save play state: {ex.Message}");
        }
    }

    public void Dispose()
    {
        PlayConnection.StateChanged -= HandleConnectionStateChanged;
        PlayConnection.LineReceived -= HandleLineReceived;
        PlayConnection.GoodbyeReceived -= HandleGoodbye;
    }

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }
}
