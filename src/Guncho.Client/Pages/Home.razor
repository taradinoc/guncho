@page "/"

<PageTitle>Guncho</PageTitle>

<div class="py-5 px-5 mb-4 bg-light rounded-3">
    <div class="container py-4">
        <div class="row align-items-top">
            <div class="col-md-8">
                <h1 class="display-4">Guncho</h1>
                <p class="lead">
                    It's more than a <abbr title="Multi-User Dungeon" class="initialism">MUD</abbr>. It's more than interactive fiction or adventure games.
                    Guncho lets you play, write, and share multiplayer interactive fiction using <a href="http://inform7.com/">Inform 7</a>.
                </p>
                <div class="d-flex flex-wrap gap-3 align-items-start mb-3">
                    <a class="btn btn-primary" href="/about" role="button">Learn More &raquo;</a>
                    <a class="btn btn-secondary" href="/play" role="button">Play Now &raquo;</a>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <img src="guncho-logo-3.svg" width="400" height="400" class="rounded" style="max-width:100%;height:auto;" alt="Guncho logo" />
            </div>
        </div>
    </div>
</div>

