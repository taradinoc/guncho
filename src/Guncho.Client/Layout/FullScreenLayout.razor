@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Guncho.Client.Auth
@using Guncho.Client.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject PlayConnectionService PlayConnection

<div class="full-screen-layout d-flex flex-column min-vh-100">
    <NavHeader Fluid="true" />

    <main class="flex-grow-1 d-flex flex-column overflow-hidden" style="min-height: 0;">
        @Body
    </main>

    <Footer Fluid="true" />
</div>
