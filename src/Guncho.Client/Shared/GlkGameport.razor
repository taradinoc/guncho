@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<style>
    /* Override GlkOte's window positioning to fill the full viewport */
    #gameport .WindowFrame.BufferWindow {
        height: 100% !important;
    }
</style>

<div id="gameport-container" style="height: 100%; width: 100%;" @ref="root">
    <!-- Gameport will be created/attached here by JavaScript -->
</div>

@code {
    [Parameter]
    public EventCallback<string> OnLineEntered { get; set; }

    private ElementReference root;
    private IJSObjectReference? module;
    private DotNetObjectReference<GlkGameport>? selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/glkWrapper.js");
        selfRef = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("init", root, selfRef);
    }

    [JSInvokable]
    public async Task OnGlkLineEntered(string line)
    {
        if (OnLineEntered.HasDelegate)
        {
            await OnLineEntered.InvokeAsync(line);
        }
    }

    public async Task AppendServerLineAsync(string line)
    {
        if (module != null)
        {
            await module.InvokeVoidAsync("appendText", line);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module != null)
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
                module = null;
            }
        }
        catch { }
        finally
        {
            selfRef?.Dispose();
            selfRef = null;
        }
    }
}
